{
  "name": "selvage-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "The Selvage Model Context Protocol server: a stdio front end for the session protocol's sync engine",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selvage-protocol/mcp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "selvage-mcp": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node --test test/e2e/*.test.ts"
  },
  "dependencies": {
    "lib0": "0.2.119",
    "ws": "8.22.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^26.6.4",
    "@types/ws": "8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "7.0.2"
  }
}
